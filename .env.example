# Application Server Port
PORT=8080
GRPC_PORT=9090

# Database Configuration
# Use 'localhost' when running the app locally on your host machine (go run ./cmd/main.go)
# Use 'db' when running inside Docker Compose
DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=data

# Security Configuration
JWT_SECRET=super-secret-jwt-key

# ACL bootstrap administrator. Change the development password before deploying.
AUTH_ADMIN_EMAIL=auth-admin@example.com
AUTH_ADMIN_PASSWORD=change-me-now
AUTH_ADMIN_FIRST_NAME=Auth
AUTH_ADMIN_LAST_NAME=Admin

# Mail Service Configuration
# MAIL_DRIVER: 'smtp', 'api' (Mailtrap API), or 'log' (console logger for dev)
MAIL_DRIVER=smtp

# Mailtrap SMTP Configuration (For local/testing with Mailtrap Sandbox SMTP)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_smtp_username
MAIL_PASSWORD=your_mailtrap_smtp_password

# Mailtrap API Configuration (For API mode: MAIL_DRIVER=api)
MAIL_API_TOKEN=your_mailtrap_api_token

# Sender Information
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Go-DDD App"
